{
    "name": "alto/frontmatter",
    "description": "Fast front matter extraction and strict YAML-subset decoding for PHP, the decoder companion for alto/markdown.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "front-matter",
        "frontmatter",
        "yaml",
        "toml",
        "metadata",
        "markdown",
        "parser",
        "static-site"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "homepage": "https://altophp.com/frontmatter",
    "support": {
        "issues": "https://github.com/altophp/frontmatter/issues",
        "source": "https://github.com/altophp/frontmatter",
        "docs": "https://altophp.com/frontmatter"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/smnandre"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Alto\\FrontMatter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\FrontMatter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "coverage": [
            "vendor/bin/phpunit --coverage-clover=.phpunit.cache/clover.xml --coverage-text",
            "@coverage:check"
        ],
        "coverage:check": "php tests/coverage-check.php .phpunit.cache/clover.xml 100",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs:fix": "vendor/bin/php-cs-fixer fix --sequential",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "vendor/bin/phpunit"
    }
}
